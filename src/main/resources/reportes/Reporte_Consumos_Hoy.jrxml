<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Reporte_Consumos_Hoy" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20"
              whenNoDataType="NoDataSection"
              uuid="315f89e4-d560-452d-ac70-86fae971f202">

    <queryString language="SQL">
        <![CDATA[SELECT
    id_servicio_reserva,
    id_reserva,
    numero_comprobante,
    cliente_nombre,
    nombre_servicio,
    cantidad,
    precio_aplicado,
    subtotal,
    fecha_consumo
FROM vista_consumos_hoy
ORDER BY id_servicio_reserva]]>
    </queryString>

    <field name="id_servicio_reserva" class="java.lang.Integer"/>
    <field name="id_reserva" class="java.lang.Integer"/>
    <field name="numero_comprobante" class="java.lang.String"/>
    <field name="cliente_nombre" class="java.lang.String"/>
    <field name="nombre_servicio" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="precio_aplicado" class="java.math.BigDecimal"/>
    <field name="subtotal" class="java.math.BigDecimal"/>
    <field name="fecha_consumo" class="java.sql.Timestamp"/>

    <variable name="totalConsumos" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{id_servicio_reserva}]]></variableExpression>
    </variable>
    <variable name="totalGeneral" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
    </variable>

    <title>
        <band height="76">
            <staticText><reportElement x="0" y="0" width="535" height="24"/><textElement textAlignment="Center"><font size="16" isBold="true"/></textElement><text><![CDATA[HOTEL EXCLUSIVE]]></text></staticText>
            <staticText><reportElement x="0" y="24" width="535" height="20"/><textElement textAlignment="Center"><font size="13" isBold="true"/></textElement><text><![CDATA[REPORTE DE SERVICIOS CONSUMIDOS HOY]]></text></staticText>
            <textField pattern="dd/MM/yyyy"><reportElement x="0" y="45" width="535" height="16"/><textElement textAlignment="Center"><font size="10"/></textElement><textFieldExpression><![CDATA["Fecha: " + new java.util.Date()]]></textFieldExpression></textField>
            <line><reportElement x="0" y="67" width="535" height="1"/></line>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText><reportElement x="0" y="0" width="50" height="20" backcolor="#1A2A44" forecolor="#FFFFFF" mode="Opaque"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[RESERVA]]></text></staticText>
            <staticText><reportElement x="50" y="0" width="100" height="20" backcolor="#1A2A44" forecolor="#FFFFFF" mode="Opaque"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/><paragraph leftIndent="3"/></textElement><text><![CDATA[CLIENTE]]></text></staticText>
            <staticText><reportElement x="150" y="0" width="145" height="20" backcolor="#1A2A44" forecolor="#FFFFFF" mode="Opaque"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/><paragraph leftIndent="3"/></textElement><text><![CDATA[SERVICIO]]></text></staticText>
            <staticText><reportElement x="295" y="0" width="40" height="20" backcolor="#1A2A44" forecolor="#FFFFFF" mode="Opaque"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[CANT]]></text></staticText>
            <staticText><reportElement x="335" y="0" width="65" height="20" backcolor="#1A2A44" forecolor="#FFFFFF" mode="Opaque"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/><paragraph rightIndent="3"/></textElement><text><![CDATA[P. UNIT.]]></text></staticText>
            <staticText><reportElement x="400" y="0" width="65" height="20" backcolor="#1A2A44" forecolor="#FFFFFF" mode="Opaque"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/><paragraph rightIndent="3"/></textElement><text><![CDATA[SUBTOTAL]]></text></staticText>
            <staticText><reportElement x="465" y="0" width="70" height="20" backcolor="#1A2A44" forecolor="#FFFFFF" mode="Opaque"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[FECHA/HORA]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <textField><reportElement x="0" y="0" width="50" height="20"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA["#" + $F{id_reserva}]]></textFieldExpression></textField>
            <textField textAdjust="StretchHeight"><reportElement x="50" y="0" width="100" height="20"/><textElement verticalAlignment="Middle"><font size="7"/><paragraph leftIndent="3"/></textElement><textFieldExpression><![CDATA[$F{cliente_nombre}]]></textFieldExpression></textField>
            <textField textAdjust="StretchHeight"><reportElement x="150" y="0" width="145" height="20"/><textElement verticalAlignment="Middle"><font size="7"/><paragraph leftIndent="3"/></textElement><textFieldExpression><![CDATA[$F{nombre_servicio}]]></textFieldExpression></textField>
            <textField><reportElement x="295" y="0" width="40" height="20"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="335" y="0" width="65" height="20"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/><paragraph rightIndent="3"/></textElement><textFieldExpression><![CDATA[$F{precio_aplicado}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="400" y="0" width="65" height="20"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/><paragraph rightIndent="3"/></textElement><textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression></textField>
            <textField pattern="dd/MM HH:mm"><reportElement x="465" y="0" width="70" height="20"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{fecha_consumo}]]></textFieldExpression></textField>
        </band>
    </detail>

    <summary>
        <band height="55">
            <line><reportElement x="0" y="4" width="535" height="1"/></line>
            <textField><reportElement x="0" y="12" width="300" height="18"/><textElement><font size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Total de consumos registrados hoy: " + $V{totalConsumos}]]></textFieldExpression></textField>
            <staticText><reportElement x="350" y="12" width="125" height="18"/><textElement textAlignment="Right"><font size="10" isBold="true"/></textElement><text><![CDATA[TOTAL SERVICIOS S/]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement x="475" y="12" width="60" height="18"/><textElement textAlignment="Right"><font size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{totalGeneral}]]></textFieldExpression></textField>
        </band>
    </summary>

    <noData>
        <band height="60">
            <staticText><reportElement x="0" y="18" width="535" height="22"/><textElement textAlignment="Center"><font size="11" isItalic="true"/></textElement><text><![CDATA[No se registraron servicios consumidos el día de hoy]]></text></staticText>
        </band>
    </noData>
</jasperReport>
